<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>19a07579-9e96-4372-8bca-27538b69693e</UserSecretsId>
	  <!-- 本機docker環境使用秘密管理員用指令：利用 MSBuild 內建變數動態組裝路徑，隱藏使用者名稱並支援跨電腦 -->
	  <DockerfileRunArguments>-v "$(AppData)\Microsoft\UserSecrets\$(UserSecretsId):/home/app/.microsoft/usersecrets/$(UserSecretsId):ro"</DockerfileRunArguments>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.1.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.11" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
    <PackageReference Include="NETCore.MailKit" Version="2.1.0" />
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <PackageReference Include="Twilio" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Areas\News\" />
    <Folder Include="DTOs\Products\" />
    <Folder Include="DTOs\Products\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common.Helpers\Common.Helpers.csproj" />
    <ProjectReference Include="..\HatsuneMIkuShop_Access\LifetimeLiveHouse.Access.csproj" />
  </ItemGroup>

	<!-- 💡 在每次建置與啟動前，自動檢查並啟動 Redis 容器 -->
	<Target Name="EnsureRedisIsRunning" BeforeTargets="Build">
		<Message Importance="high" Text="正在檢查並啟動本機 Redis 容器..." />
		<!-- 邏輯：先嘗試啟動已存在的 local-redis，如果失敗 (代表還沒建立)，就執行 docker run 建立一個新的 -->
		<Exec Command="docker start local-redis || docker run -d --name local-redis -p 6379:6379 redis:alpine" IgnoreExitCode="true" />
	</Target>
</Project>
